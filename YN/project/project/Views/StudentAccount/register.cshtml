<body>

    <!-- NOTICE: You can use the _analytics.html partial to include production code specific code & trackers -->


    <main class="bg-light py-5" style="min-height:100vh;">
        <div class="container">
            <p class="text-center mb-4">
                <a href="https://localhost:7185/" class="text-decoration-none">
                    <svg class="icon icon-xs me-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" d="M7.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd" />
                    </svg>
                    回首頁
                </a>
            </p>

            <div class="row justify-content-center">
                <div class="col-12 col-md-8 col-lg-6">
                    <div class="bg-white shadow-sm rounded p-4 p-md-5">
                        <h2 class="text-center mb-4">註冊新帳號</h2>

                        <form asp-action="register" method="post">
                            <div class="mb-3">
                                <label asp-for="UserName" class="form-label">帳號</label>
                                <input asp-for="UserName" class="form-control" placeholder="請輸入帳號" required />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Password" class="form-label">密碼</label>
                                <input asp-for="Password" class="form-control" type="password" placeholder="請輸入密碼" required />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label">姓名</label>
                                <input asp-for="Name" class="form-control" placeholder="請輸入姓名" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">性別</label><br />
                                <div class="form-check form-check-inline">
                                    <input asp-for="Gender" class="form-check-input" type="radio" value="男" />
                                    <label class="form-check-label">男</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input asp-for="Gender" class="form-check-input" type="radio" value="女" />
                                    <label class="form-check-label">女</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input asp-for="Gender" class="form-check-input" type="radio" value="其他" />
                                    <label class="form-check-label">其他</label>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="BirthDate" class="form-label">生日</label>
                                <input asp-for="BirthDate" class="form-control" type="date" required />
                            </div>
                            <div class="mb-3">
                                <label asp-for="City" class="form-label">縣市</label>
                                <input asp-for="City" class="form-control" placeholder="請輸入居住縣市" required />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Phone" class="form-label">電話</label>
                                <input asp-for="Phone" class="form-control" placeholder="請輸入電話" required />
                            </div>
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label">電子信箱</label>
                                <input asp-for="Email" class="form-control" placeholder="請輸入信箱" required />
                            </div>

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-primary">註冊</button>
                            </div>
                        </form>

                        <div class="text-center mt-4">
                            <p>已經有帳號了嗎？<a href="@Url.Action("memberLogin", "StudentAccount")">點此登入</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>


    <!-- Core -->
    <script src="../../vendor/@@popperjs/core/dist/umd/popper.min.js"></script>
    <script src="../../vendor/bootstrap/dist/js/bootstrap.min.js"></script>

    <!-- Vendor JS -->
