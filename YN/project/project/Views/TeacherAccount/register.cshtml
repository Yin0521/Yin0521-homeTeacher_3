<body>

    <!-- NOTICE: You can use the _analytics.html partial to include production code specific code & trackers -->


    <main>

        <!-- Section -->
        <section class="vh-lg-100 mt-5 mt-lg-0 bg-soft d-flex align-items-center">
            <div class="container">
                <p class="text-center">
                    <a href="https://localhost:7185/" class="d-flex align-items-center justify-content-center">
                        <svg class="icon icon-xs me-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M7.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd"></path></svg>
                        回首頁
                    </a>
                </p>
                <div class="row justify-content-center form-bg-image" data-background-lg="../../assets/img/illustrations/signin.svg">
                    <div class="col-12 d-flex align-items-center justify-content-center">
                        <div class="bg-white shadow border-0 rounded border-light p-4 p-lg-5 w-100 fmxw-500">
                            <div class="text-center text-md-center mb-4 mt-md-0">
                                <h1 class="mb-0 h3">註冊 </h1>
                            </div>
                            <form asp-action="register" method="post"  class="mt-4">
                                <input type="hidden" name="role" value="@Model" />
                                <!-- Form -->
                                <div class="form-group">
                                    <label class="control-label">username</label>
                                    <input asp-for="UserName" placeholder="帳號" required />
                                </div>
                                <div class="form-group">
                                    <label class="control-label">password</label>
                                    <input asp-for="Password" type="password" placeholder="密碼" required />
                                </div>
                                <div class="form-group">
                                    <label class="control-label">name</label>
                                    <input asp-for="Name" placeholder="姓名" required />
                                </div>
                                <label>性別：</label>
                                <input asp-for="Gender" type="radio" value="男" /> 男
                                <input asp-for="Gender" type="radio" value="女" /> 女
                                <input asp-for="Gender" type="radio" value="其他" /> 其他
                                <br />

                                <div class="form-group">
                                    <label class="control-label">BirthDate</label>
                                    <input asp-for="BirthDate" type="date" placeholder="生日" required />
                                </div>
                                <div class="form-group">
                                    <label class="control-label">City</label>
                                    <input asp-for="City" placeholder="縣市" required />
                                </div>

                                <div class="form-group">
                                    <label class="control-label">phone</label>
                                    <input asp-for="Phone" placeholder="電話" required />
                                </div>
                                <div class="form-group">
                                    <label class="control-label">email</label>
                                    <input asp-for="Email" placeholder="信箱" required />
                                </div>
                                <div class="form-group">
                                    <label class="control-label">Introduction</label>
                                    <input asp-for="Introduction" placeholder="自我介紹" required />
                                </div>
                                <div class="form-group">
                                    <label class="control-label">SubjectSpecialty</label>
                                    <input asp-for="SubjectSpecialty" placeholder="擅長科目" />
                                </div>
                                <label>擅長科目：</label>
                                @foreach (var subject in (List<Subject>)ViewBag.Subjects)
                                {
                                    <input type="checkbox" name="SubjectIDs" value="@subject.Id" /> @subject.Name
                                }
                                <div class="form-group">
                                    <label class="control-label">ExperienceYears</label>
                                    <input asp-for="ExperienceYears" placeholder="年資" required />
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn btn-gray-800">註冊</button>
                                </div>
                            </form>
                            <div class="d-flex justify-content-center align-items-center mt-4">
                                <span class="fw-normal">
                                    已經有帳號了?
                                    <a href="@Url.Action("memberLogin", "TeacherAccount")" class="fw-bold">登入點這</a>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Core -->
    <script src="../../vendor/@@popperjs/core/dist/umd/popper.min.js"></script>
    <script src="../../vendor/bootstrap/dist/js/bootstrap.min.js"></script>

    <!-- Vendor JS -->
    <script src="../../vendor/onscreen/dist/on-screen.umd.min.js"></script>

    <!-- Slider -->
