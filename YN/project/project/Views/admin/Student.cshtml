    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model List<project.Models.adminStudent>
@{

	ViewBag.Title = "伴學網 — 學生頁";
}


<div class="page-title">

	<div class="title-env" style="margin-left:30px;">
		<h1 class="title">學生頁面</h1>
		<p class="description">家教系統管理人員</p>
		<div class="col-md-3">
			<form method="get" action="extra-search.html" style="display: flex; align-items: center;">
				<input type="text" name="s" class="form-control search-field" placeholder="search" />

				<button type="submit" class="btn btn-link">
					<i class="linecons-search"></i>
				</button>
			</form>
		</div>
	</div>

</div>

<!-- Table Styles -->

<div class="row">
	<div class="col-md-12">

		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title">學生</h3>




				<div class="panel-options">
					<a href="#">
						<i class="linecons-cog"></i>
					</a>

					<a href="#" data-toggle="panel">
						<span class="collapse-icon">&ndash;</span>
						<span class="expand-icon">+</span>
					</a>

					<a href="#" data-toggle="reload">
						<i class="fa-rotate-right"></i>
					</a>

					<a href="#" data-toggle="remove">
						&times;
					</a>
				</div>
			</div>
			<div class="panel-body">

				<div class="row">
					<div class="col-sm-8">

						<!-- Basic Table -->
						@if (ViewBag.Role == "superadmin")
						{
							<a href="@Url.Action("CreateStudent","admin")">新增學生</a>
						}

						<table class="table responsive">
							<thead>
								<tr>
									<th>#</th>
									<th>帳號</th>
									<th>姓名</th>
									<th>性別</th>
									<th>縣市</th>
									<th>生日</th>
									<th>Email</th>
									<th>電話</th>
									<th>餘額</th>
									<th>註冊日期</th>
									<th>狀態</th>
									<th>操作</th>
								</tr>
							</thead>

							<tbody>
								@if (Model != null && Model.Count > 0)
								{
									int i = 1;
									foreach (var student in Model)
									{
										<tr>
											<td>@i</td>
											<td>@student.UserName</td>
											<td>@student.Name</td>
											<td>@student.Gender</td>
											<td>@student.City</td>
											<td>@student.BirthDate</td>
											<td>@student.Email</td>
											<td>@student.Phone</td> <!-- 可以後續遮蔽或改顯示登入時間等 -->
											<td>@student.TokenBalance</td>
											<td>@student.RegisterDate.ToString("yyyy/MM/dd HH:mm")</td>
											<td>@(student.IsActive ? "啟用" : "停用")</td>
											@if (ViewBag.Role == "superadmin")
											{
												<td>
													<a href="@Url.Action("StudentEdit", "admin", new { id = student.ID })">
														<button type="button" class="btn btn-gray">編輯</button>
													</a>
												</td>
												<td>
													<form asp-action="StudentDelete" asp-route-id="@student.ID" method="post" onsubmit="return confirm('確定要刪除？')">
														<button type="submit" class="btn btn-danger">刪除</button>
													</form>
												</td>
											}

										</tr>

										i++;
									}
								}
								else
								{
									<tr><td colspan="6">目前沒有學生資料。</td></tr>
								}
							</tbody>
						</table>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>
