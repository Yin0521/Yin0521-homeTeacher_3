@model List<NewsletterSubscriberViewModel>
@{

    ViewBag.Title = "伴學網 — 意見回饋處理";
}

<h2 class="mt-4">電子報訂閱者管理</h2>

<table class="table table-bordered table-hover mt-3">
    <thead class="table-dark">
        <tr>
            <th>編號</th>
            <th>Email</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Email</td>
                <td>
                    <form asp-action="DeleteSubscriber" method="post" style="display:inline">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('確定要刪除？');">刪除</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>


