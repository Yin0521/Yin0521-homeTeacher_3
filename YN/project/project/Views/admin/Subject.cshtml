@model List<project.Models.Subject>

@{

	ViewBag.Title = "伴學網 — 科目管理";
}


<div class="page-title">

	<div class="title-env" style="margin-left:30px;">
		<h1 class="title">科目管理</h1>
		<p class="description">家教系統管理人員</p>
		<div class="col-md-3">
			<form method="get" action="extra-search.html" style="display: flex; align-items: center;">
				<input type="text" name="s" class="form-control search-field" placeholder="search" />

				<button type="submit" class="btn btn-link">
					<i class="linecons-search"></i>
				</button>
			</form>
		</div>
	</div>

</div>

<!-- Table Styles -->

<div class="row">
	<div class="col-md-12">

		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title">科目管理</h3>




				<div class="panel-options">
					<a href="#">
						<i class="linecons-cog"></i>
					</a>

					<a href="#" data-toggle="panel">
						<span class="collapse-icon">&ndash;</span>
						<span class="expand-icon">+</span>
					</a>

					<a href="#" data-toggle="reload">
						<i class="fa-rotate-right"></i>
					</a>

					<a href="#" data-toggle="remove">
						&times;
					</a>
				</div>
			</div>
			<div class="panel-body">

				<div class="row">
					<div class="col-sm-8">

						<!-- Basic Table -->
						
						<a class="btn btn-primary" href="@Url.Action("SubjectCreate","admin")">新增科目</a>
						

						<table class="table mt-3">
							<thead>
								<tr>
									<th>ID</th>
									<th>名稱</th>
									<th>操作</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var subject in Model)
								{
									<tr>
										<td>@subject.Id</td>
										<td>@subject.Name</td>
										<td>
											@* <a class="btn btn-sm btn-warning" href="@Url.Action("SubjectEdit","admin" ,new { id = subject.Id })">編輯</a> *@
											<a class="btn btn-sm btn-danger" href="@Url.Action("SubjectDelete","admin", new { id = subject.Id })">刪除</a>
										</td>
									</tr>
								}
							</tbody>
						</table>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>
