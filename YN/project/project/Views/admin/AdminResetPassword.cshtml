@model project.Models.ResetPasswordViewModel
@{
	

	ViewBag.Title = "伴學網 — 管理員編輯頁";
}
<style>
	form{
		display:grid;
		grid-auto-rows:80px;
	}
	form input, form div{
		width:60%;
	}
</style>


<div class="page-title">

	<div class="title-env" style="margin-left:30px;">
		<h1 class="title">管理員頁面</h1>
		<p class="description">家教系統管理人員</p>
		<div class="col-md-3">
			<form method="get" action="extra-search.html" style="display: flex; align-items: center;">
				<input type="text" name="s" class="form-control search-field" placeholder="search" />

				<button type="submit" class="btn btn-link">
					<i class="linecons-search"></i>
				</button>
			</form>
		</div>
	</div>

</div>

<!-- Table Styles -->

<div class="row">
	<div class="col-md-12">

		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title">重設密碼 - @Model.UserName</h3>
				<div class="panel-options">
					<a href="#">
						<i class="linecons-cog"></i>
					</a>

					<a href="#" data-toggle="panel">
						<span class="collapse-icon">&ndash;</span>
						<span class="expand-icon">+</span>
					</a>

					<a href="#" data-toggle="reload">
						<i class="fa-rotate-right"></i>
					</a>

					<a href="#" data-toggle="remove">
						&times;
					</a>
				</div>
			</div>
			<div class="panel-body">

				<div class="row">
					<div class="col-sm-6">

						<!-- Basic Table -->

						<div class="panel panel-default">

							

							<div class="panel-body">

								<form asp-action="AdminResetPassword" method="post">
									<input type="hidden" name="ID" value="@Model.ID" />
									<div class="form-group">
										<label>新密碼</label>
										<input name="NewPassword" type="password" class="form-control" />
										@if (ViewBag.NewPasswordError != null)
										{
											<div style="color:red">@ViewBag.NewPasswordError</div>
										}
									</div>
									<div class="form-group">
										<label>再次輸入新密碼</label>
										<input name="ConfirmPassword" type="password" class="form-control" />
										@if (ViewBag.ConfirmPasswordError != null)
										{
											<div style="color:red">@ViewBag.ConfirmPasswordError</div>
										}
									</div>
									<div class="form-group">
										<button type="submit" class="btn btn-success">確認重設</button>
										<a asp-action="AdminEdit" asp-route-id="@Model.ID" class="btn btn-secondary">取消</a>
									</div>
								</form>
							</div>
						</div>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>
