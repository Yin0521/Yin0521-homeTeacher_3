    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@model List<project.Models.AdminOrderViewModel>

@{

	ViewBag.Title = "伴學網 — 待學生確認訂單";
}
@functions {
	string StatusText(OrderStatus status)
	{
		switch (status)
		{
			case OrderStatus.Pending: return "待老師確認";
			case OrderStatus.Accepted: return "待學生確認";
			case OrderStatus.Confirmed: return "進行中";
			case OrderStatus.TeacherCompleted: return "老師已完成";
			case OrderStatus.StudentCompleted: return "學生已完成";
			case OrderStatus.Finished: return "訂單已完成";
			case OrderStatus.StudentCancelled: return "學生取消";
			case OrderStatus.TeacherRejected: return "老師拒絕";
			default: return "";
		}
	}
}

<div class="page-title">

	<div class="title-env" style="margin-left:30px;">
		<h1 class="title">待學生確認訂單</h1>
		<p class="description">家教系統管理人員</p>
		<div class="col-md-3">
			<form method="get" action="extra-search.html" style="display: flex; align-items: center;">
				<input type="text" name="s" class="form-control search-field" placeholder="search" />

				<button type="submit" class="btn btn-link">
					<i class="linecons-search"></i>
				</button>
			</form>
		</div>
	</div>

</div>

<!-- Table Styles -->

<div class="row">
	<div class="col-md-12">

		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title">待學生確認訂單</h3>




				<div class="panel-options">
					<a href="#">
						<i class="linecons-cog"></i>
					</a>

					<a href="#" data-toggle="panel">
						<span class="collapse-icon">&ndash;</span>
						<span class="expand-icon">+</span>
					</a>

					<a href="#" data-toggle="reload">
						<i class="fa-rotate-right"></i>
					</a>

					<a href="#" data-toggle="remove">
						&times;
					</a>
				</div>
			</div>
			<div class="panel-body">

				<div class="row">
					<div class="col-sm-8">

						<!-- Basic Table -->



						<table class="table mt-3">
							<thead>
								<tr>
									<th>訂單編號</th>
									<th>學生</th>
									<th>老師</th>
									<th>科目</th>
									<th>狀態</th>
									<th>下單時間</th>
									<th>操作</th>
									<th>刪除</th>
								</tr>
							</thead>
							<tbody>
								@foreach (var order in Model)
								{
									<tr>
										<td>@order.OrderID</td>
										<td>@order.StudentName (ID:@order.StudentID)</td>
										<td>@order.TeacherName (ID:@order.TeacherID)</td>
										<td>@order.SubjectName</td>
										<td>
											@{
												string statusClass = "badge ";
												switch (order.OrderStatus)
												{
													case OrderStatus.Pending:
														statusClass += "badge-primary"; // 待老師確認
														break;
													case OrderStatus.Accepted:
														statusClass += "badge-warning"; // 待學生確認
														break;
													case OrderStatus.Confirmed:
													case OrderStatus.Finished:
														statusClass += "badge-success"; // 已完成
														break;
													case OrderStatus.StudentCancelled:
													case OrderStatus.TeacherRejected:
														statusClass += "badge-danger"; // 取消
														break;
													default:
														statusClass += "badge-secondary";
														break;
												}
											}
											<p class="@statusClass" style="font-size:1.2rem; padding:1rem">
												@StatusText(order.OrderStatus)
											</p>
										</td>
										<td>@order.CreateTime?.ToString("yyyy/MM/dd HH:mm")</td>
										<td>
											<a class="btn btn-sm btn-primary" href="@Url.Action("OrderDetail", "admin", new { id = order.OrderID })">查看明細</a>
											@* 根據狀態可加其他操作 *@
										</td>
										<td>
											@if (ViewBag.Role == "superadmin")
											{
												<form asp-action="DeleteOrder" asp-controller="admin" asp-route-id="@order.OrderID" method="post" style="display:inline;" onsubmit="return confirm('確定要刪除嗎？');">
													<button type="submit" class="btn btn-danger btn-sm">刪除</button>
												</form>
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
						@if (!Model.Any())
						{
							<div class="alert alert-info text-center">目前尚無訂單紀錄</div>
						}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
