@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model project.Models.AdminTeacherEditViewModel
@{


	ViewBag.Title = "伴學網 — 教師編輯頁";
}
<style>
	form {
		display: grid;
	}

		form input, form div {
			margin: 5px;
		}
</style>


<div class="page-title">

	<div class="title-env" style="margin-left:30px;">
		<h1 class="title">教師頁面</h1>
		<p class="description">家教系統管理人員</p>
		<div class="col-md-3">
			<form method="get" action="extra-search.html" style="display: flex; align-items: center;">
				<input type="text" name="s" class="form-control search-field" placeholder="search" />

				<button type="submit" class="btn btn-link">
					<i class="linecons-search"></i>
				</button>
			</form>
		</div>
	</div>

</div>

<!-- Table Styles -->

<div class="row">
	<div class="col-md-12">

		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title">編輯教師</h3>
				<div class="panel-options">
					<a href="#">
						<i class="linecons-cog"></i>
					</a>

					<a href="#" data-toggle="panel">
						<span class="collapse-icon">&ndash;</span>
						<span class="expand-icon">+</span>
					</a>

					<a href="#" data-toggle="reload">
						<i class="fa-rotate-right"></i>
					</a>

					<a href="#" data-toggle="remove">
						&times;
					</a>
				</div>
			</div>
			<div class="panel-body">

				<div class="row">
					<div class="col-sm-8">

						<!-- Basic Table -->

						<div class="panel panel-default">
                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger">
                                    <ul>
                                        @foreach (var key in ViewData.ModelState.Keys)
                                        {
                                            var errors = ViewData.ModelState[key].Errors;
                                            foreach (var error in errors)
                                            {
                                                <li>
                                                    @if (!string.IsNullOrEmpty(key) && key != "Teacher")
                                                    {
                                                        @($"{key}: ")
                                                    }
                                                    @error.ErrorMessage
                                                </li>
                                            }
                                        }
                                    </ul>
                                </div>
                            }


							<div class="panel-body">

                                <form asp-action="TeacherEdit" method="post" enctype="multipart/form-data" class="row g-3">

                                    <div class="form-group">
                                        <label asp-for="Teacher.UserName" class="form-label">帳號</label>
                                        <input asp-for="Teacher.UserName" class="form-control" required />
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Teacher.Name" class="form-label">姓名</label>
                                        <input asp-for="Teacher.Name" class="form-control" />
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label">性別</label><br />
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" asp-for="Teacher.Gender" type="radio" value="男" />
                                            <label class="form-check-label">男</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" asp-for="Teacher.Gender" type="radio" value="女" />
                                            <label class="form-check-label">女</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" asp-for="Teacher.Gender" type="radio" value="其他" />
                                            <label class="form-check-label">其他</label>
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Teacher.BirthDate" class="form-label">生日</label>
                                        <input asp-for="Teacher.BirthDate" type="date" class="form-control" />
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Teacher.City" class="form-label">縣市</label>
                                        <input asp-for="Teacher.City" class="form-control" />
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Teacher.Phone" class="form-label">電話</label>
                                        <input asp-for="Teacher.Phone" class="form-control" />
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Teacher.Email" class="form-label">信箱</label>
                                        <input asp-for="Teacher.Email" class="form-control" />
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Teacher.Introduction" class="form-label">自我介紹</label>
                                        <textarea asp-for="Teacher.Introduction" class="form-control" rows="2"></textarea>
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Teacher.SubjectSpecialty" class="form-label">專長科目</label>
                                        <input asp-for="Teacher.SubjectSpecialty" class="form-control" />
                                    </div>

                                    <div class="form-group">
                                        <label asp-for="Teacher.ExperienceYears" class="form-label">年資</label>
                                        <input asp-for="Teacher.ExperienceYears" class="form-control" />
                                    </div>

                                    @* 
                                    還未做這功能
                                    <div class="form-group"> *@
                                    @*     <label asp-for="Teacher.TokenBalance" class="form-label">餘額</label> *@
                                    @*     <input asp-for="Teacher.TokenBalance" class="form-control" /> *@
                                    @* </div> *@

                                    <div class="form-group">
                                        <label asp-for="Teacher.IsActive" class="form-label">狀態</label>
                                        <select asp-for="Teacher.IsActive" class="form-select">
                                            <option value="true">啟用</option>
                                            <option value="false">停用</option>
                                        </select>
                                    </div>

                                    <div class="form-group">
                                        <label class="form-label">擅長科目</label>
                                        <div class="row">
                                            @foreach (var subject in Model.AllSubjects)
                                            {
                                                <div class="col-md-3 col-6 mb-2">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" name="SelectedSubjectIds[]" value="@subject.Id"
                                                        @(Model.SelectedSubjectIds.Contains(subject.Id) ? "checked" : "") />
                                                        <label class="form-check-label">@subject.Name</label>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <input type="hidden" asp-for="Teacher.ID" />

                                    <div class="form-group d-flex justify-content-between mt-3">
                                        <button type="button" class="btn btn-secondary" onclick="history.back()">回上一頁</button>
                                        <button type="submit" class="btn btn-success">儲存變更</button>
                                        <a class="btn btn-warning" href="@Url.Action("TeacherResetPassword", "Admin", new { id = Model.Teacher.ID })">重設密碼</a>


                                    </div>
                                </form>

							</div>
						</div>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>
