@model List<project.Models.adminAccount>
@{
	
	ViewBag.Title = "伴學網 — 管理員編輯頁";
}


<div class="page-title">

	<div class="title-env" style="margin-left:30px;">
		<h1 class="title">管理員頁面</h1>
		<p class="description">家教系統管理人員</p>
		<div class="col-md-3">
			<form method="get" action="extra-search.html" style="display: flex; align-items: center;">
				<input type="text" name="s" class="form-control search-field" placeholder="search" />

				<button type="submit" class="btn btn-link">
					<i class="linecons-search"></i>
				</button>
			</form>
		</div>
	</div>

</div>

<!-- Table Styles -->

<div class="row">
	<div class="col-md-12">

		<div class="panel panel-default">
			<div class="panel-heading">
				<h3 class="panel-title">管理員</h3>

				<div class="panel-options">
					<a href="#">
						<i class="linecons-cog"></i>
					</a>

					<a href="#" data-toggle="panel">
						<span class="collapse-icon">&ndash;</span>
						<span class="expand-icon">+</span>
					</a>

					<a href="#" data-toggle="reload">
						<i class="fa-rotate-right"></i>
					</a>

					<a href="#" data-toggle="remove">
						&times;
					</a>
				</div>
			</div>
			<div class="panel-body">

				<div class="row">
					<div class="col-sm-6">

						<!-- Basic Table -->
						

						<table class="table responsive">
							<thead>
								<tr>
									<th></th>
									<th>姓名</th>
									<th>聯繫方式</th>
									<th>權限</th>
									<th>啟用狀態</th>
									<th>建立時間</th>
								</tr>
							</thead>

							<tbody>
								@if (Model != null && Model.Count > 0)
								{
									int i = 1;
									foreach (var admin in Model)
									{
										<tr>
											<td>@i</td>
											<td>@admin.name</td>
											<td>@admin.phone</td> <!-- 可以後續遮蔽或改顯示登入時間等 -->
											<td>@admin.role</td>
											<td>@(admin.is_active ? "啟用" : "停用")</td>
											<td>@admin.created_at.ToString("yyyy/MM/dd HH:mm")</td>
										</tr>
										i++;
									}
								}
								else
								{
									<tr><td colspan="6">目前沒有管理員資料。</td></tr>
								}
							</tbody>
						</table>

					</div>
				</div>
			</div>
		</div>
	</div>
</div>
