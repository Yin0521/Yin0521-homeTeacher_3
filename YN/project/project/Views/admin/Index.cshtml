@{
	ViewBag.Title = "伴學網 — 管理頁";
}
@model project.Models.DashboardStats



	<div class="main-content">

		<!-- User Info, Notifications and Menu Bar -->
		<nav class="navbar user-info-navbar" role="navigation">

			<!-- Left links for user info navbar -->
			<ul class="user-info-menu left-links list-inline list-unstyled">

				<li class="hidden-sm hidden-xs">
					<a href="#" data-toggle="sidebar">
						<i class="fa-bars"></i>
					</a>
				</li>


			</ul>


			<!-- Right links for user info navbar -->
			<ul class="user-info-menu right-links list-inline list-unstyled">

				<li class="search-form">
					<!-- You can add "always-visible" to show make the search input visible -->

					<form method="get" action="extra-search.html">
						<input type="text" name="s" class="form-control search-field" placeholder="Type to search..." />

						<button type="submit" class="btn btn-link">
							<i class="linecons-search"></i>
						</button>
					</form>

				</li>

				<li class="dropdown user-profile">
					<a href="#" data-toggle="dropdown">
						<span>
							@ViewBag.AdminUsername
						</span>
					</a>
				</li>

			</ul>

		</nav>
	<div class="container-fluid px-4">

		<!-- 1. KPI 區（四個指標，一排四格） -->
		<div class="row mb-4">
			<div class="col-md-3 mb-3">
				<div class="xe-widget xe-counter">
					<div class="xe-icon"><i class="linecons-cloud"></i></div>
					<div class="xe-label">
						<strong class="num" id="serverUptime">@Model.ServerUptime</strong>
						<span>Server 運作時間</span>
					</div>
				</div>
			</div>
			<div class="col-md-3 mb-3">
				<div class="xe-widget xe-counter xe-counter-purple">
					<div class="xe-icon"><i class="linecons-diamond"></i></div>
					<div class="xe-label">
						<strong class="num" id="matchedOrders">@Model.MatchedOrders</strong>
						<span>媒合成功數量</span>
					</div>
				</div>
			</div>
			<div class="col-md-3 mb-3">
				<div class="xe-widget xe-counter xe-counter-green">
					<div class="xe-icon"><i class="linecons-user"></i></div>
					<div class="xe-label">
						<strong class="num" id="activeStudentCount">@Model.ActiveStudentCount</strong>
						<span>一週活躍學生</span>
					</div>
				</div>
			</div>
			<div class="col-md-3 mb-3">
				<div class="xe-widget xe-counter xe-counter-blue">
					<div class="xe-icon"><i class="linecons-user"></i></div>
					<div class="xe-label">
						<strong class="num" id="activeTeacherCount">@Model.ActiveTeacherCount</strong>
						<span>一週活躍老師</span>
					</div>
				</div>
			</div>
		</div>

		<!-- 2. 註冊趨勢圖＋註冊成長率＋總數（兩欄） -->
		<div class="row mb-4 align-items-stretch">
			<div class="col-md-8 mb-3">
				<div class="chart-item-bg p-3 h-100">
					<div class="chart-label">
						<div class="h4 fw-bold mb-1">每月註冊數量</div>
						<span class="text-medium text-muted">包含學生與老師</span>
					</div>
					<canvas id="monthlyRegisterChart" style="height:298px;"></canvas>
				</div>
			</div>
			<div class="col-md-4 mb-3">
				<div class="row g-3">
					<div class="col-12">
						<div class="xe-widget xe-counter">
							<div class="xe-label">
								<strong class="num">@Model.TotalTeachers</strong>
								<span>老師總數</span>
							</div>
						</div>
					</div>
					<div class="col-12">
						<div class="xe-widget xe-counter xe-counter-green">
							<div class="xe-label">
								<strong class="num">@Math.Round(Model.StudentRegisterGrowthPercent, 2)%</strong>
								<span>學生註冊成長率</span>
							</div>
						</div>
					</div>
					<div class="col-12">
						<div class="xe-widget xe-counter xe-counter-purple">
							<div class="xe-label">
								<strong class="num">@Model.TotalStudents</strong>
								<span>學生總數</span>
							</div>
						</div>
					</div>
					<div class="col-12">
						<div class="xe-widget xe-counter xe-counter-blue">
							<div class="xe-label">
								<strong class="num">@Math.Round(Model.TeacherRegisterGrowthPercent, 2)%</strong>
								<span>老師註冊成長率</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- 3. 訂單狀態圓餅圖，置中 -->
		<div class="row mb-4">
			<div class="col-md-12 d-flex justify-content-center">
				<div style="max-width:400px;">
					<h4 class="text-center">訂單狀態</h4>
					<canvas id="orderStatusPieChart"></canvas>
				</div>
			</div>
		</div>

		<!-- 4. TOP 科目排行（老師、學生） -->
		<div class="row mb-4">
			<div class="col-md-6 mb-3">
				<h5 class="fw-bold">老師教學科目排行</h5>
				<canvas id="subjectBar"></canvas>
			</div>
			<div class="col-md-6 mb-3">
				<h5 class="fw-bold">學生熱門科目排行</h5>
				<canvas id="subjectOrderBar"></canvas>
			</div>
		</div>

		<!-- 5. 城市分布（老師、學生） -->
		<div class="row mb-4">
			<div class="col-md-6 mb-3">
				<h5 class="fw-bold">老師城市分布</h5>
				<canvas id="teacherCityBar"></canvas>
			</div>
			<div class="col-md-6 mb-3">
				<h5 class="fw-bold">學生城市分布</h5>
				<canvas id="studentCityBar"></canvas>
			</div>
		</div>

	</div>
	

	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/countup.js@2.8.0/dist/countUp.umd.js"></script>
	<script>
		// const stats = [
		// 	{ month: "2025-03", studentCount: 3, teacherCount: 1 },
		// 	{ month: "2025-04", studentCount: 4, teacherCount: 2 },
		// 	{ month: "2025-05", studentCount: 2, teacherCount: 7 },
		// 	{ month: "2025-06", studentCount: 2, teacherCount: 2 }
		// ];
			// 折線圖（每月註冊數量）
		const stats = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MonthlyRegisterStats));
		function safe(val, fallback) { return typeof val !== "undefined" ? val : fallback; }
		const registerLabels = stats.map(x => safe(x.month, x.Month));
		const students = stats.map(x => safe(x.studentCount, x.StudentCount));
		const teachers = stats.map(x => safe(x.teacherCount, x.TeacherCount));

		new Chart(document.getElementById('monthlyRegisterChart'), {
			type: 'line',
			data: {
				labels: registerLabels,
				datasets: [
					{ label: '學生註冊', data: students, borderColor: 'green', fill: false },
					{ label: '老師註冊', data: teachers, borderColor: 'blue', fill: false }
				]
			}
		});

		// 圓餅圖（訂單狀態）
		const statusMap = {
		  0: "待老師確認", 1: "待學生確認", 2: "進行中",
		  3: "老師已完成", 4: "學生已完成", 5: "已完成",
		  6: "學生取消", 7: "老師拒絕"
		};
		const pieData = @Html.Raw(ViewBag.OrderStatusCounts);
		const pieLabels = pieData.map(x => statusMap[x.Status]);
		const pieCounts = pieData.map(x => x.Count);

		new Chart(document.getElementById('orderStatusPieChart'), {
			type: 'pie',
			data: {
				labels: pieLabels,
				datasets: [{
					data: pieCounts,
					backgroundColor: [
						"#68b828", "#7c38bc", "#0e62c7", "#fcd036",
						"#4fcdfc", "#00b19d", "#ff6264", "#f7aa47"
					]
				}]
			},
			options: {
				plugins: {
					legend: {
						display: true,
						position: 'bottom',
						align: 'center'
					}
				}
			}
		});


		const topSubjects = @Html.Raw(ViewBag.TopSubjects ?? "[]");
		const studentCities = @Html.Raw(ViewBag.StudentCities ?? "[]");
		const teacherCities = @Html.Raw(ViewBag.TeacherCities ?? "[]");
		const topOrderSubjects = @Html.Raw(ViewBag.TopOrderSubjects ?? "[]");
	

		// 老師熱門科目 長條圖
		const subjectCtx = document.getElementById('subjectBar').getContext('2d');
		new Chart(subjectCtx, {
			type: 'bar',
			data: {
				labels: topSubjects.map(x => x.Name),
				datasets: [{
					label: '老師數量',
					data: topSubjects.map(x => x.Count),
					borderWidth: 1
				}]
			},
			options: {
				responsive: true,
				plugins: {
					legend: { display: false }
				},
				scales: {
					y: { beginAtZero: true }
				}
			}
		});

		// 學生城市 長條圖
		const cityCtx = document.getElementById('studentCityBar').getContext('2d');
		new Chart(cityCtx, {
			type: 'bar',
			data: {
				labels: studentCities.map(x => x.City),
				datasets: [{
					label: '學生數量',
					data: studentCities.map(x => x.Count),
					borderWidth: 1
				}]
			},
			options: {
				responsive: true,
				plugins: {
					legend: { display: false }
				},
				scales: {
					y: { beginAtZero: true }
				}
			}
		});

		// 老師城市 長條圖
		const teachercityCtx = document.getElementById('teacherCityBar').getContext('2d');
		new Chart(teachercityCtx, {
			type: 'bar',
			data: {
				labels: teacherCities.map(x => x.City),
				datasets: [{
					label: '老師數量',
					data: teacherCities.map(x => x.Count),
					borderWidth: 1
				}]
			},
			options: {
				responsive: true,
				plugins: {
					legend: { display: false }
				},
				scales: {
					y: { beginAtZero: true }
				}
			}
		});

		// 學生熱門科目 長條圖
		const subjectOrderCtx = document.getElementById('subjectOrderBar').getContext('2d');
		new Chart(subjectOrderCtx, {
			type: 'bar',
			data: {
					labels: topOrderSubjects.map(x => x.Name),
					datasets: [{
					label: '學生數量',
					data: topOrderSubjects.map(x => x.Count),
					borderWidth: 1
				}]
			},
			options: {
				responsive: true,
				plugins: {
					legend: { display: false }
				},
				scales: {
					y: { beginAtZero: true }
				}
			}
		});



			

	</script>

	<!--另外兩個div結尾在layout-->

		<!-- Main Footer -->
		
