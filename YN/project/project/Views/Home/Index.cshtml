                        <div class="item">
                            <div class="tst-image">
                                <img src="images/tst-image4.jpg" class="img-responsive" alt="">
                            </div>
                            <div class="tst-author">
                                <h4>Andrio</h4>
                                <span>Web 工程師</span>
                            </div>
                            <p>Web 業內需要的技能工具在這裡都能學到，我會推薦給其他人的！</p>
                            <div class="tst-rating">
                                <i class="fa fa-star"></i>
                                <i class="fa fa-star"></i>
                                <i class="fa fa-star"></i>
                                <i class="fa fa-star"></i>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</section>


<!-- CONTACT -->
<section id="contact">
    <div class="container">
        <div class="row">

            <div class="col-md-6 col-sm-12">
                <form asp-controller="Home" asp-action="SubmitFeedback" method="post">
                    <div class="section-title">
                        <h2>聯絡我們 <small>有甚麼需求或是疑問都可以直接來跟我們交流，勇敢的踏出第一步吧!</small></h2>
                    </div>

                    <div class="col-md-12 col-sm-12">
                        <input type="text" class="form-control" placeholder="輸入您的暱稱" name="name" required="">

                        <input type="email" class="form-control" placeholder="輸入您的Email" name="email" required="">

                        <textarea class="form-control" rows="6" placeholder="請輸入您的訊息" name="message" required=""></textarea>
                    </div>

                    <div class="col-md-4 col-sm-12">
                        <input type="submit" class="form-control" name="send message" value="送出">
                    </div>

                </form>
            </div>

            <div class="col-md-6 col-sm-12">
                <div class="contact-image">
                    <img src="images/contact-image.jpg" class="img-responsive" alt="Smiling Two Girls">
                </div>
            </div>

        </div>
    </div>
</section>
@* 意見回饋彈窗0603 *@
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    @if (TempData["Success"] != null)
    {
        <text>
                Swal.fire({
                    icon: 'success',
                    title: '成功',
                    text: @Html.Raw(Json.Serialize(TempData["Success"]))
                });
        </text>
    }

    @if (TempData["Error"] != null)
    {
        <text>
                Swal.fire({
                    icon: 'error',
                    title: '錯誤',
                    text: @Html.Raw(Json.Serialize(TempData["Error"]))
                });
        </text>
    }
</script>
