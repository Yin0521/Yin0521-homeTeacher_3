@{
    ViewData["Title"] = "伴學網 — 家教1對1教學平台";
}
<!-- HOME -->
<section id="home">
    <div class="row">

        <div class="owl-carousel owl-theme home-slider">
            <div class="item item-first">
                <div class="caption">
                    <div class="container">
                        <div class="col-md-6 col-sm-12">
                            <h1>遠端學習教育</h1>
                            <h3>我們的在線課程旨在適合您的行業，並通過最新技術為全方位提供支持。</h3>
                            <a href="#feature" class="section-btn btn btn-default smoothScroll">關於我們</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="item item-second">
                <div class="caption">
                    <div class="container">
                        <div class="col-md-6 col-sm-12">
                            <h1>從我們的課程開始您的旅程</h1>
                            <h3>我們的在線課程與技術主管合作建立，旨在滿足行業需求。</h3>
                            <a href="#courses" class="section-btn btn btn-default smoothScroll">熱門項目</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="item item-third">
                <div class="caption">
                    <div class="container">
                        <div class="col-md-6 col-sm-12">
                            <h1>有效的學習方法</h1>
                            <h3>我們的在線課程旨在目的明確的學習，旨在最適合您的需求</h3>
                            <a href="#contact" class="section-btn btn btn-default smoothScroll">聯絡我們</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- FEATURE -->
<section id="feature">
    <div class="container">
        <div class="row">

            <div class="col-md-4 col-sm-4">
                <div class="feature-thumb">
                    <span>01</span>
                    <h3>熱門課程</h3>
                    <p>您可以在這裡找到當前最受歡迎的課程，涵蓋科技、商業、語言等多個領域。這些課程不僅由經驗豐富的教師授課，還包括互動式學習和實際項目，幫助學生在實踐中提升技能。</p>
                </div>
            </div>

            <div class="col-md-4 col-sm-4">
                <div class="feature-thumb">
                    <span>02</span>
                    <h3>書籍資源</h3>
                    <p>我們的家教平台提供豐富的學習資源，包括電子書籍和學術資料庫。學生可以隨時隨地訪問這些資源，並利用平台上的學習工具和社群活動，增強他們的學習體驗，培養終身學習的習慣。</p>
                </div>
            </div>

            <div class="col-md-4 col-sm-4">
                <div class="feature-thumb">
                    <span>03</span>
                    <h3>教師資源</h3>
                    <p>我們的家教平台擁有一批經過認證的教師，他們具備專業的教學資格和豐富的教學經驗。這些教師不僅能提供高質量的教學，還會持續進行專業發展，以確保他們的教學方法與時俱進，滿足學生的需求。</p>
                </div>
            </div>

        </div>
    </div>
</section>


<!-- ABOUT -->
<section id="about">
    <div class="container">
        <div class="row">

            <div class="col-md-6 col-sm-12">
                <div class="about-info">
                    <h2>透過線上與線下課程開啟您的美好生活之旅</h2>

                    <figure>
                        <span><i class="fa fa-users"></i></span>
                        <figcaption>
                            <h3>雙方平等的媒合機構</h3>
                            <p>我們致力於促進學習者和教師之間的平等交流。無論您是尋找專業指導還是希望分享自己的知識，我們都提供一個公平的環境讓雙方獲得最佳的體驗。</p>
                        </figcaption>
                    </figure>

                    <figure>
                        <span><i class="fa fa-certificate"></i></span>
                        <figcaption>
                            <h3>輔助帶你考取國際認證</h3>
                            <p>我們的課程不僅著重於知識的傳授，還專注於幫助學習者獲得國際認證。我們將協助您在全球範圍內提升自身的競爭力，讓您在職場上脫穎而出。</p>
                        </figcaption>
                    </figure>

                    <figure>
                        <span><i class="fa fa-bar-chart-o"></i></span>
                        <figcaption>
                            <h3>免費註冊使用</h3>
                            <p>為了讓更多人受益，我們提供免費平台且給予300點代幣。讓您可以先無風險地體驗我們的課程和服務，探索適合的學習方式，並開始您的成長旅程。</p>
                        </figcaption>
                    </figure>
                </div>
            </div>

            <div class="col-md-offset-1 col-md-4 col-sm-12">
                <div class="entry-form">
                        <h2>立即註冊</h2>

                    <a href="@Url.Action("register", "StudentAccount")" class="submit-btn form-control">前往註冊</a>
                    
                </div>
            </div>

        </div>
    </div>
</section>


<!-- 推薦老師區塊0603修改 -->
<section id="team">
    <div class="container">
        <div class="row">
            <div class="col-md-12 col-sm-12">
                <div class="section-title">
                    <h2>推薦老師 <small>根據平台推薦</small></h2>
                </div>
            </div>
            @foreach (var teacher in ViewBag.RecommendedTeachers as List<RecommendedTeacher>)
            {
                <div class="col-md-3 col-sm-6">
                    <div class="team-thumb">
                        <div class="team-image">
                                <img src="@teacher.DisplayPhoto" class="img-responsive img-thumbnail rounded-circle" style="width:300px;height:300px;object-fit:cover;" alt="老師頭像">
                        </div>
                        <div class="team-info">
                            <h3>
                                    @teacher.Name
                            </h3>
                            @* 顯示科目陣列 *@
                            <span>@string.Join("、", teacher.Subjects)</span>
                        </div>
                        <ul class="social-icon">
                            <li><a href="mailto:@teacher.Email" class="fa fa-envelope-o"></a></li>
                            <li><a href="tel:@teacher.Phone" class="fa fa-phone"></a></li>
                        </ul>
                    </div>
                </div>
            }
        </div>
    </div>
</section>


<!-- 課程介紹0603修改 -->
<section id="courses">
    <div class="container">
        <div class="row">

            <div class="col-md-12 col-sm-12">
                <div class="section-title">
                    <h2>課程介紹 <small>了解平台開設的各科課程</small></h2>
                </div>

                <div class="owl-carousel owl-theme owl-courses">
                    @foreach (var subject in ViewBag.SubjectList as List<Subject>)
                    {
                        <div class="col-md-4 col-sm-4">
                            <div class="item">
                                <div class="courses-thumb">

                                    <div class="courses-detail">
                                        <h3><a href="#">@subject.Name</a></h3>
                                        <p>@subject.Description</p>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
</section>


