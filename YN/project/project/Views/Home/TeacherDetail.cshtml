@{
    ViewData["Title"] = "student";
}
@{
    Layout = "~/Views/Shared/student_layout.cshtml";
}

    @model project.Models.TeacherOrderViewModel
<style>
    .row div{
        margin:3rem auto;
    }
</style>

<div class="container my-4">
    <div class="row">
        <!-- 左側 老師介紹 -->
        <div class="col-lg-7 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="card-title">@Model.Teacher.Name 老師介紹</h2>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><strong>專長科目：</strong>@Model.Teacher.SubjectSpecialty</li>
                        <li class="list-group-item"><strong>年齡：</strong>@(DateTime.Now.Year - Model.Teacher.BirthDate.Year)</li>
                        <li class="list-group-item"><strong>城市：</strong>@Model.Teacher.City</li>
                        <li class="list-group-item"><strong>信箱：</strong>@Model.Teacher.Email</li>
                        <li class="list-group-item"><strong>電話：</strong>@Model.Teacher.Phone</li>
                    </ul>
                    <div class="mt-3">
                        <strong>自我介紹：</strong>
                        <p class="mb-0">@Model.Teacher.Introduction</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右側 下訂單表單 -->
        <div class="col-lg-5 mb-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title mb-3">預約下單</h4>
                    <form asp-controller="Order" asp-action="Create" method="post">
                        <input type="hidden" name="teacherId" value="@Model.Teacher.ID" />
                        <div class="mb-3">
                            <label class="form-label">預約科目</label>
                            <select name="subjectId" class="form-select" required>
                                <option value="">請選擇科目</option>
                                @foreach (var subject in Model.Subjects)
                                {
                                    <option value="@subject.Id">@subject.Name</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">需求留言</label>
                            <textarea class="form-control" name="message" rows="4" placeholder="請簡述您的需求"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">下訂單</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>