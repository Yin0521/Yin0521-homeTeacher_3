@model project.Models.OrderViewModel
@{
    ViewData["Title"] = "訂單明細";
    Layout = "~/Views/Shared/student_layout.cshtml";
}
@functions {
    string StatusText(OrderStatus status)
    {
        switch (status)
        {
            case OrderStatus.Pending: return "待老師確認";
            case OrderStatus.Accepted: return "待學生確認";
            case OrderStatus.Confirmed: return "進行中";
            case OrderStatus.TeacherCompleted: return "老師已完成";
            case OrderStatus.StudentCompleted: return "學生已完成";
            case OrderStatus.Finished: return "訂單已完成";
            case OrderStatus.StudentCancelled: return "學生取消";
            case OrderStatus.TeacherRejected: return "老師拒絕";
            default: return "";
        }
    }
}

<style>
    .order-detail-container {
        max-width: 600px;
        min-height: 60vh;
        margin: 40px auto 40px auto;
        padding: 36px 32px 40px 32px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(30,30,60,0.07);
    }

    .order-title {
        font-size: 2.5rem;
        font-weight: bold;
        margin-bottom: 1.6rem;
        letter-spacing: 0.04em;
        text-align: center;
    }

    .order-meta {
        font-size: 1.8rem;
        margin-bottom: 0.7rem;
        line-height: 2;
    }

    .order-actions form {
        display: inline-block;
        margin-right: 10px;
    }

    .order-actions button {
        min-width: 120px;
        margin-top: 10px;
    }
    @@media (max-width: 700px) {
        .order-detail-container

    {
        max-width: 98vw;
        padding: 1rem;
    }

    }
</style>

<div class="order-detail-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="badge bg-secondary">Role: @ViewBag.Role</span>
        <span class="badge bg-info text-dark">Status: @StatusText(Model.OrderStatus)</span>
    </div>

    <div class="order-title">訂單明細</div>
    <div class="order-meta"><strong>訂單編號：</strong>@Model.OrderID</div>
    <div class="order-meta"><strong>學生：</strong>@Model.StudentName (ID: @Model.StudentID)</div>
    <div class="order-meta"><strong>老師：</strong>@Model.TeacherName (ID: @Model.TeacherID)</div>
    <div class="order-meta"><strong>科目：</strong>@Model.SubjectName (ID: @Model.SubjectID)</div>
    <div class="order-meta"><strong>建立時間：</strong>@Model.CreateTime?.ToString("yyyy/MM/dd HH:mm")</div>
    <div class="order-meta"><strong>下單留言：</strong>@Model.Message</div>
    <hr />

    <div class="order-actions text-center mt-4">
    @* 老師還沒接單，顯示同意/拒絕 *@
        @if (ViewBag.Role == "Teacher" && Model.OrderStatus == OrderStatus.Pending)
        {
            <form asp-action="TeacherAccept" method="post">
                <input type="hidden" name="id" value="@Model.OrderID" />
                <button type="submit" class="btn btn-success">同意接單</button>
            </form>
            <form asp-action="TeacherReject" method="post">
                <input type="hidden" name="id" value="@Model.OrderID" />
                <button type="submit" class="btn btn-danger">拒絕</button>
            </form>
        }
        @* 學生同意訂單 *@
        @if (ViewBag.Role == "Student" && Model.OrderStatus == OrderStatus.Accepted)
        {
            <form asp-action="StudentConfirm" method="post">
                <input type="hidden" name="id" value="@Model.OrderID" />
                <button type="submit" class="btn btn-success">我已與老師聯繫並同意訂單</button>
            </form>
        }
        @* 雙方完成階段（"Confirmed" 狀態） *@
        @if (Model.OrderStatus == OrderStatus.Confirmed)
        {
            if (ViewBag.Role == "Teacher")
            {
                <form asp-action="TeacherFinish" method="post">
                    <input type="hidden" name="id" value="@Model.OrderID" />
                    <button type="submit" class="btn btn-info">老師完成教學</button>
                </form>
            }
            if (ViewBag.Role == "Student")
            {
                <form asp-action="StudentFinish" method="post">
                    <input type="hidden" name="id" value="@Model.OrderID" />
                    <button type="submit" class="btn btn-info">學生確認完成</button>
                </form>
            }
        }
        @* 進階：如果只剩一方完成，再讓另一方出現按鈕，完成後變已完成 *@
        @if (Model.OrderStatus == OrderStatus.TeacherCompleted && ViewBag.Role == "Student")
        {
            <form asp-action="StudentFinish" method="post">
                <input type="hidden" name="id" value="@Model.OrderID" />
                <button type="submit" class="btn btn-info">學生確認完成</button>
            </form>
        }
        @if (Model.OrderStatus == OrderStatus.StudentCompleted && ViewBag.Role == "Teacher")
        {
            <form asp-action="TeacherFinish" method="post">
                <input type="hidden" name="id" value="@Model.OrderID" />
                <button type="submit" class="btn btn-info">老師完成教學</button>
            </form>
        }

        @* 取消訂單（可加條件限制，這裡是「尚未完成」皆可） *@
        @if (
        (ViewBag.Role == "Student" && (Model.OrderStatus == OrderStatus.Pending || Model.OrderStatus == OrderStatus.Accepted || Model.OrderStatus == OrderStatus.Confirmed || Model.OrderStatus == OrderStatus.TeacherCompleted)) ||
        (ViewBag.Role == "Teacher" && (Model.OrderStatus == OrderStatus.Pending || Model.OrderStatus == OrderStatus.Confirmed || Model.OrderStatus == OrderStatus.StudentCompleted))
        )
        {
            <form asp-action="StudentCancel" method="post">
                <input type="hidden" name="id" value="@Model.OrderID" />
                <button type="submit" class="btn btn-secondary">取消訂單</button>
            </form>
        }
    </div>
</div>
